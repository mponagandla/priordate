# PriorDate Environment Variables Template
# Copy this file to .env for local testing (never commit .env to git)

SUPABASE_URL=https://your-project.supabase.co
# Secret Key (new format: sbs_...) OR classic Service Role Key (service_role JWT)
# Used by backend scrapers to bypass RLS for data upserts
SUPABASE_SERVICE_KEY=your-supabase-secret-or-service-role-key
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/WEBHOOK/URL
